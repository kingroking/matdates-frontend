rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /live_events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /event_competitors/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site_stats/{docId} {
      allow read, write: if true;
    }
    match /scraper_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pending_events/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /reminders/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /venue_comments/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /mat_watches/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
